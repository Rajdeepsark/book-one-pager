---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  titleLang?: string;
  author: string;
  cover?: ImageMetadata;
  /** Line breaks for the placeholder cover only. */
  coverTitleLines: string[];
  /** Load the cover straight away, for a cover above the fold. */
  priority?: boolean;
  class?: string;
}

const { title, titleLang, author, cover, coverTitleLines, priority = false, class: className } = Astro.props;
const coverAlt = `Cover of ${title} by ${author}`;
---

<!-- Flat front cover that fills its parent: the real cover image, or a placeholder whose type scales with the cover width -->
<div class:list={['@container relative size-full overflow-hidden bg-jacket text-main', className]}>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt}
        widths={[404, 808]}
        sizes="404px"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="size-full object-cover"
      />
    ) : (
      <div role="img" aria-label={coverAlt} class="flex h-full flex-col justify-between pt-[13cqw] pr-[11cqw] pb-[11cqw] pl-[14cqw]">
        <p
          lang={titleLang}
          class="text-[length:16.8cqw] leading-[0.98] font-extrabold tracking-display [&:lang(as)]:leading-[1.15] [&:lang(as)]:tracking-[-0.01em]"
        >
          {coverTitleLines.map((line, i) => (
            <Fragment>
              {line}
              {i < coverTitleLines.length - 1 && <br />}
            </Fragment>
          ))}
        </p>
        <p class="text-[length:4cqw] font-bold tracking-[-0.01em]">{author}</p>
      </div>
    )
  }
</div>
