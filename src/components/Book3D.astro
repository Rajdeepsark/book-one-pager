---
import type { ImageMetadata } from 'astro';
import CoverArt from './CoverArt.astro';

interface Props {
  title: string;
  titleLang?: string;
  author: string;
  cover?: ImageMetadata;
  /** Line breaks for the placeholder cover only. */
  coverTitleLines: string[];
  /** Size the book with --book-w, --book-h and --book-d (depth). */
  class?: string;
  /** Load the cover straight away, for a book above the fold. */
  priority?: boolean;
  /** Soft contact shadow under the book, for a book standing on a surface. */
  grounded?: boolean;
}

const { class: className, grounded = true, ...cover } = Astro.props;
---

<!-- Turns slightly toward the viewer when an ancestor with the `group` class is hovered. Extra content (annotations) goes in the slot. -->
<div class:list={['relative h-(--book-h) w-(--book-w) perspective-[2400px]', className]}>
  <div
    class="absolute inset-0 -rotate-y-24 transition-transform duration-600 ease-settle transform-3d group-hover:-rotate-y-16 motion-reduce:transition-none"
  >
    <div
      class="absolute inset-0 -translate-z-[calc(var(--book-d)/2)] rounded-l-[2px] rounded-r-[5px] bg-jacket-back shadow-book"
    >
    </div>
    <div
      class="absolute top-1 left-0 h-[calc(var(--book-h)-8px)] w-[calc(var(--book-d)-2px)] translate-x-[calc(var(--book-w)-var(--book-d)/2-3px)] rotate-y-90 book-fore-edge"
    >
    </div>
    <!-- Front cover, with spine hinge, sheen and paper grain on top -->
    <div class="absolute inset-0 translate-z-[calc(var(--book-d)/2)] overflow-hidden rounded-l-[2px] rounded-r-[5px]">
      <CoverArt {...cover} />
      <div class="pointer-events-none absolute inset-0 cover-lighting"></div>
      <div class="pointer-events-none absolute inset-0 bg-grain opacity-30 mix-blend-multiply"></div>
    </div>
  </div>

  {
    grounded && (
      <div
        class="absolute -bottom-[calc(var(--book-h)*0.024)] left-[2%] right-[-4%] h-[calc(var(--book-h)*0.048)] -skew-x-20 bg-[radial-gradient(50%_50%_at_50%_50%,rgb(40_30_20/0.4),rgb(40_30_20/0))] blur-[3px]"
        aria-hidden="true"
      />
    )
  }

  <slot />
</div>
