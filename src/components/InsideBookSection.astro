---
import type { InsideBookContent } from '../data/book';
import CheckIcon from './CheckIcon.astro';
import SectionIntro from './SectionIntro.astro';
import TableOfContents from './TableOfContents.astro';

interface Props {
  content: InsideBookContent;
  previewUrl: string;
}

const { content, previewUrl } = Astro.props;
---

<section id="inside" aria-labelledby="inside-title" class="relative z-10 px-gutter py-section">
  <div class="mx-auto max-w-page">
    <!-- Takeaways: a narrow block, centred on the page -->
    <div class="mx-auto max-w-xl">
      <SectionIntro
        id="inside-title"
        align="left"
        eyebrow={content.eyebrow}
        headline={content.headline}
        description={content.description}
      />
      <ul class="mx-auto mt-8 w-fit space-y-3.5 md:mx-0">
        {
          content.takeaways.map((takeaway) => (
            <li class="flex gap-3 text-title font-bold">
              <CheckIcon class="mt-[0.2em] size-5 text-muted" />
              {takeaway}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-center text-title font-extrabold text-primary md:text-left">
        {content.finalStatement}
      </p>
    </div>

    <TableOfContents
      class="mt-section"
      heading={content.toc.heading}
      ctaLabel={content.toc.ctaLabel}
      ctaHref={previewUrl}
      chapters={content.toc.chapters}
    />
  </div>
</section>
