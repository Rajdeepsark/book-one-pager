---
import { Image } from 'astro:assets';
import type { Book } from '../data/book';
import Button from './Button.astro';
import CoverArt from './CoverArt.astro';

interface Props {
  book: Book;
}

const { book } = Astro.props;
const { nav } = book;
---

<!-- Sticky bar; gains a hairline border once the page scrolls. Below lg the links fold into a menu. -->
<header
  data-site-nav
  data-scrolled="false"
  class="sticky top-0 z-50 border-b border-transparent bg-background/90 px-5 backdrop-blur-md transition-colors duration-200 data-[scrolled=true]:border-border sm:px-8 lg:px-12"
>
  <div class="mx-auto flex h-16 max-w-page items-center gap-3 lg:h-18 lg:gap-10">
    <a
      href="#top"
      class="mr-auto flex min-w-0 items-center gap-2.5 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary lg:mr-0"
    >
      {
        nav.logo ? (
          <Image src={nav.logo} alt={book.title} height={72} class="h-9 w-auto" />
        ) : (
          <Fragment>
            <span
              aria-hidden="true"
              class="block h-9 w-6 shrink-0 overflow-hidden rounded-l-[1px] rounded-r-[3px] shadow-[0_1px_2px_rgb(0_0_0/0.12),1px_3px_6px_-2px_rgb(40_30_20/0.3)]"
            >
              <CoverArt
                title={book.title}
                titleLang={book.titleLang}
                author={book.author}
                cover={book.cover}
                coverTitleLines={book.coverTitleLines}
              />
            </span>
            <span lang={book.titleLang} class="truncate text-[17px] font-extrabold tracking-[-0.03em]">
              {book.title}
            </span>
          </Fragment>
        )
      }
    </a>

    <nav aria-label="Sections" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-7 text-sm font-semibold">
        {
          nav.links.map((link) => (
            <li>
              <a
                data-nav-link
                href={link.href}
                class="text-secondary transition-colors hover:text-main aria-[current=true]:text-main"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={nav.cta.href} size="sm" class="shrink-0">{nav.cta.label}</Button>

    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Menu"
      class="group grid size-10 shrink-0 cursor-pointer place-items-center rounded-full border border-border bg-surface text-main focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:hidden"
    >
      <svg viewBox="0 0 20 20" class="size-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path class="group-aria-expanded:hidden" d="M3.5 6.5h13M3.5 13.5h13"></path>
        <path class="hidden group-aria-expanded:block" d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>
  </div>

  <!-- Menu for small screens, overlaying the page below the bar -->
  <nav
    id="nav-menu"
    aria-label="Sections"
    hidden
    class="absolute inset-x-0 top-full border-b border-border bg-background px-5 pb-4 shadow-[0_16px_30px_-24px_rgb(40_30_20/0.4)] sm:px-8 lg:hidden"
  >
    <ul class="mx-auto max-w-page">
      {
        nav.links.map((link) => (
          <li class="border-b border-border last:border-0">
            <a
              data-nav-link
              href={link.href}
              class="flex items-center justify-between py-4 text-base font-semibold text-secondary transition-colors hover:text-main aria-[current=true]:text-main"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-nav]');

  if (header) {
    // Hairline border once the page has scrolled
    const onScroll = () => (header.dataset.scrolled = String(window.scrollY > 8));
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Small-screen menu
    const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
    const menu = header.querySelector<HTMLElement>('#nav-menu')!;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(menu.hidden));
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => event.matches && setOpen(false));

    // Highlight the link for the section in the middle of the screen; sections without a link clear it
    const links = [...header.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]')];
    const sections = document.querySelectorAll<HTMLElement>('main section[id]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));  }
</script>
