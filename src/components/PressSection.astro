---
import type { PressCoverage } from '../data/book';
import PressLogos from './PressLogos.astro';
import ReviewSwitcher from './ReviewSwitcher.astro';
import SectionIntro from './SectionIntro.astro';

interface Props {
  coverage: PressCoverage;
}

const { coverage } = Astro.props;
---

<section id="press" aria-labelledby="press-title" class="relative z-10 px-gutter py-section">
  <div class="mx-auto max-w-page">
    <SectionIntro
      id="press-title"
      eyebrow={coverage.eyebrow}
      headline={coverage.headline}
      description={coverage.description}
    />

    <PressLogos
      outlets={coverage.outlets}
      size="lg"
      class="mt-stack justify-center gap-x-[clamp(2rem,1rem+3vw,3.5rem)] gap-y-6 text-muted"
    />

    <div class="mt-section">
      <p class="mb-8 text-center eyebrow">{coverage.reviewsEyebrow}</p>
      <ReviewSwitcher reviews={coverage.reviews} />
    </div>
  </div>
</section>
