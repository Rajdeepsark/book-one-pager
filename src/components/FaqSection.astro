---
import type { FaqContent } from '../data/book';
import SectionIntro from './SectionIntro.astro';

interface Props {
  content: FaqContent;
}

const { content } = Astro.props;
---

<section id="faq" aria-labelledby="faq-title" class="relative z-10 px-5 pt-16 pb-24 sm:px-8 lg:px-12 lg:pt-20 lg:pb-32">
  <div class="mx-auto max-w-page">
    <SectionIntro
      id="faq-title"
      eyebrow={content.eyebrow}
      headline={content.headline}
      description={content.description}
    />

    <!-- Native disclosure rows: work without JavaScript and answers are searchable with find-in-page -->
    <div class="mx-auto mt-12 max-w-212 border-t border-border sm:mt-14">
      {
        content.items.map((item, i) => (
          <details open={i === 0} class="faq-item group border-b border-border">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-sm py-5 text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:py-6 [&::-webkit-details-marker]:hidden">
              <span class="text-[17px] leading-snug font-bold tracking-[-0.02em] sm:text-lg">{item.question}</span>
              <span
                aria-hidden="true"
                class="grid size-8 shrink-0 place-items-center rounded-full border border-border text-secondary transition-[rotate,color,background-color,border-color] duration-300 group-hover:text-main group-open:rotate-45 group-open:border-primary/30 group-open:bg-primary/10 group-open:text-primary motion-reduce:transition-none"
              >
                <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <path d="M8 2.5v11M2.5 8h11" />
                </svg>
              </span>
            </summary>
            <p class="pr-14 pb-6 text-[15px] leading-relaxed text-secondary sm:text-base">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Smooth open and close where supported; elsewhere rows simply open instantly */
  .faq-item {
    interpolate-size: allow-keywords;
  }
  .faq-item::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 300ms var(--ease-settle),
      content-visibility 300ms allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
