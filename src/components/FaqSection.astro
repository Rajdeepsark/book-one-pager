---
import type { FaqContent } from '../data/book';
import SectionIntro from './SectionIntro.astro';

interface Props {
  content: FaqContent;
}

const { content } = Astro.props;
---

<section id="faq" aria-labelledby="faq-title" class="relative z-10 px-gutter py-section">
  <div class="mx-auto max-w-page">
    <SectionIntro
      id="faq-title"
      eyebrow={content.eyebrow}
      headline={content.headline}
      description={content.description}
    />

    <!-- Native disclosure rows: work without JavaScript and answers are searchable with find-in-page -->
    <!-- One white card; dividers are inset from its edges and the last row has none -->
    <div class="mx-auto mt-stack max-w-212 rounded-2xl border border-border bg-surface px-card">
      {
        content.items.map((item, i) => (
          <details open={i === 0} class="faq-item group border-b border-border last:border-0">
            <summary class="flex cursor-pointer list-none items-center gap-5 rounded-sm py-5 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
              <svg
                viewBox="0 0 16 16"
                class="size-4 shrink-0 text-muted transition-[rotate,color] duration-300 group-hover:text-secondary group-open:rotate-45 group-open:text-primary motion-reduce:transition-none"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M8 1.5v13M1.5 8h13" />
              </svg>
              <span class="text-base leading-snug font-semibold tracking-[-0.01em]">{item.question}</span>
            </summary>
            <p class="pb-5 pl-9 text-[15px] leading-relaxed text-secondary">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Smooth open and close where supported; elsewhere rows simply open instantly */
  .faq-item {
    interpolate-size: allow-keywords;
  }
  .faq-item::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 300ms var(--ease-settle),
      content-visibility 300ms allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
