---
interface Props {
  /** Heading id, for the section's aria-labelledby. */
  id: string;
  eyebrow?: string;
  headline: string;
  description?: string;
  /** 'left' still centres below md, like the rest of the page. */
  align?: 'center' | 'left';
  class?: string;
}

const { id, eyebrow, headline, description, align = 'center', class: className } = Astro.props;
const centered = align === 'center';
---

<header
  class:list={['mx-auto max-w-160 text-center', !centered && 'md:mx-0 md:max-w-none md:text-left', className]}
>
  {eyebrow && <p class="mb-5 eyebrow">{eyebrow}</p>}
  <h2 id={id} class="text-h2 font-extrabold text-balance">
    {headline}
  </h2>
  {
    description && (
      <p class:list={['mx-auto mt-5 max-w-120 text-lead text-secondary', !centered && 'md:mx-0']}>
        {description}
      </p>
    )
  }
</header>
