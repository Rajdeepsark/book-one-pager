---
import type { ImageMetadata } from 'astro';
import Book3D from './Book3D.astro';
import CircledWord from './CircledWord.astro';

interface Props {
  title: string;
  titleLang?: string;
  author: string;
  cover?: ImageMetadata;
  coverTitleLines: string[];
  quote: { before: string; circled: string; after: string };
}

const { quote, ...book } = Astro.props;
---

<!--
  Stage: soft light falling on the book; hovering turns the book slightly toward the viewer.
  One fluid width (--book-w) drives the book and every annotation: 220–300px stacked, then 28% of the
  screen up to 404px side by side, where the stage also reserves room for the overhanging sticky note.
-->
<div
  class="group relative grid place-items-center pt-8 pb-12 [--book-w:clamp(13.75rem,55vw,18.75rem)] before:pointer-events-none before:absolute before:-inset-x-[18%] before:-inset-y-[12%] before:bg-[radial-gradient(closest-side,rgb(255_255_255/0.95),rgb(255_255_255/0))] md:pr-[calc(var(--book-w)_*_0.25_-_1.75rem)] md:[--book-w:clamp(14rem,28vw,25.25rem)]"
>
  <Book3D {...book} priority>
    <!-- Annotations: a separate layer around the book -->
    <svg
      class="absolute -top-[calc(var(--book-w)_*_0.039_+_1.5rem)] -right-[calc(var(--book-w)_*_0.078_+_0.9rem)] size-[calc(var(--book-w)_*_0.117_+_1.05rem)] overflow-visible"
      viewBox="0 0 64 64"
      aria-hidden="true"
    >
      <path class="hand-stroke stroke-[3.4]" d="M6 50 C 12 40, 18 32, 26 22"></path>
      <path class="hand-stroke stroke-[3.4]" d="M16 58 C 28 55, 40 53, 56 50"></path>
      <path class="hand-stroke stroke-[3.4]" d="M2 36 C 1 26, 2 16, 4 6"></path>
    </svg>

    <figure
      class="absolute -right-[calc(var(--book-w)_*_0.25_-_1.75rem)] bottom-[calc(var(--book-w)_*_0.42_-_2.5rem)] m-0 w-[calc(var(--book-w)_*_0.5_+_2.5rem)] -rotate-4 px-[calc(var(--book-w)_*_0.04_+_0.375rem)] pt-[calc(var(--book-w)_*_0.04_+_1.125rem)] pb-[calc(var(--book-w)_*_0.04_+_0.625rem)] shadow-note sticky-paper"
    >
      <blockquote
        class="m-0 text-[length:calc(var(--book-w)_*_0.02_+_0.6rem)] leading-[1.38] font-bold tracking-[-0.015em] text-sticky-ink"
      >
        {quote.before} <CircledWord>{quote.circled}</CircledWord>{quote.after}
      </blockquote>
    </figure>
  </Book3D>
</div>
