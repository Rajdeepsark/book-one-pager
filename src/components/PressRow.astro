---
import type { PressOutlet } from '../data/book';
import PressLogos from './PressLogos.astro';

interface Props {
  label: string;
  outlets: PressOutlet[];
  class?: string;
}

const { label, outlets, class: className } = Astro.props;
---

<div class:list={['border-t border-border pt-6', className]}>
  <p class="mb-3.5 text-[11px] font-bold tracking-eyebrow text-secondary uppercase">{label}</p>
  <PressLogos outlets={outlets} class="justify-center gap-x-5 gap-y-3 text-muted md:justify-start" />
</div>
