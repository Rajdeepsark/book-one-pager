---
import type { Book } from '../data/book';
import BookMockup from './BookMockup.astro';
import Button from './Button.astro';
import PressRow from './PressRow.astro';

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<section
  id="top"
  aria-labelledby="book-title"
  class="relative z-10 grid place-items-center overflow-x-clip px-gutter pt-[clamp(1.5rem,0.5rem+3vw,3.5rem)] pb-section"
>
  <!-- From md: the book column hugs the book (it reserves room for the overhanging sticky note itself) -->
  <div
    class="grid w-full max-w-page grid-cols-1 items-center gap-6 md:grid-cols-[auto_minmax(0,1fr)] md:gap-x-[clamp(1.5rem,1rem+1.5vw,2.5rem)]"
  >
    <BookMockup
      title={book.title}
      titleLang={book.titleLang}
      author={book.author}
      cover={book.cover}
      coverTitleLines={book.coverTitleLines}
      quote={book.quote}
    />

    <div class="mx-auto w-full max-w-140 text-center md:mx-0 md:max-w-none md:text-left">
      <p class="mb-5 eyebrow">{book.eyebrow}</p>
      <h1
        id="book-title"
        lang={book.headlineLang}
        class="text-display font-extrabold text-balance [&:lang(as)]:leading-[1.2] [&:lang(as)]:tracking-[-0.01em]"
      >
        {book.headline}
      </h1>
      <p class="mx-auto mt-6 max-w-110 text-lead text-secondary md:mx-0">
        {book.description}
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3 md:justify-start">
        <Button href={book.primaryCta.href} class="flex-1 sm:flex-none">{book.primaryCta.label}</Button>
        <Button href={book.secondaryCta.href} variant="secondary" class="flex-1 sm:flex-none">
          {book.secondaryCta.label}
        </Button>
      </div>

      <PressRow label={book.press.label} outlets={book.press.outlets} class="mt-12" />

      <p class="mt-6 text-sm text-secondary">
        By <span class="font-bold text-main">{book.author}</span>
        <span class="mx-1.5 text-muted" aria-hidden="true">·</span>
        {book.language}
      </p>
    </div>
  </div>
</section>
