---
import type { Book, PurchaseContent } from '../data/book';
import Book3D from './Book3D.astro';
import Button from './Button.astro';
import CoverArt from './CoverArt.astro';
import DeviceMockup from './DeviceMockup.astro';
import ReaderScreen from './ReaderScreen.astro';
import SectionIntro from './SectionIntro.astro';
import StarRating from './StarRating.astro';

interface Props {
  content: PurchaseContent;
  /** For the cover on the product shots. */
  book: Book;
}

const { content, book } = Astro.props;
const { rating } = content;
const cover = {
  title: book.title,
  titleLang: book.titleLang,
  author: book.author,
  cover: book.cover,
  coverTitleLines: book.coverTitleLines,
};
// Placeholder ratings show five stars
const stars = Math.round(Number.parseFloat(rating.value)) || 5;
const cardClass = 'group rounded-2xl border border-border bg-surface-secondary/60';
---

<section id="buy" aria-labelledby="buy-title" class="relative z-10 px-gutter py-section">
  <div class="mx-auto max-w-page">
    <SectionIntro id="buy-title" headline={content.heading} />

    <!-- Purchase options -->
    <div class="mt-stack grid gap-5 md:grid-cols-2">
      {
        content.options.map((option) => (
          <article class:list={[cardClass, 'flex flex-col items-center px-card pt-[calc(var(--spacing-card)_*_1.25)] pb-card text-center']}>
            <!-- Product shot: one fluid height (--shot) sizes the devices and the book -->
            <div class="relative flex h-(--shot) w-full items-end justify-center [--shot:clamp(13.5rem,11rem+6vw,16rem)]">
              {option.format === 'ebook' ? (
                <Fragment>
                  <DeviceMockup kind="tablet" class="w-[calc(var(--shot)_*_0.69)]">
                    <CoverArt {...cover} />
                  </DeviceMockup>
                  <DeviceMockup kind="phone" class="absolute bottom-0 left-1/2 w-[calc(var(--shot)_*_0.31)] -translate-x-[150%]">
                    <ReaderScreen />
                  </DeviceMockup>
                </Fragment>
              ) : (
                <Book3D
                  {...cover}
                  class="mb-2 [--book-d:calc(var(--book-w)_*_0.16)] [--book-w:calc(var(--shot)_*_0.625)]"
                />
              )}
            </div>
            <h3 class="mt-7 text-h3 font-extrabold">{option.heading}</h3>
            <p class="mt-1 text-[15px] text-secondary">{option.details}</p>
            <!-- Several buttons stack while the card is narrow and sit side by side once there's room -->
            <div
              class:list={[
                'mt-6 grid w-full gap-3',
                option.ctas.length > 1 ? 'max-w-md sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2' : 'max-w-xs',
              ]}
            >
              {option.ctas.map((cta, i) => (
                <Button href={cta.href} variant={i === 0 ? 'primary' : 'secondary'} class="w-full">
                  {cta.label}
                </Button>
              ))}
            </div>
            {option.link && (
              <a
                href={option.link.href}
                class="mt-4 text-sm font-semibold text-secondary underline decoration-border underline-offset-4 transition-colors hover:text-main hover:decoration-current"
              >
                {option.link.label}
              </a>
            )}
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-secondary">
      <StarRating rating={stars} decorative size="size-4" class="gap-0.5" />
      <span>{rating.value} · {rating.reviewCount} reviews</span>
    </div>
  </div>
</section>
