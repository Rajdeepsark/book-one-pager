---
import { Image } from 'astro:assets';
import type { FooterContent } from '../data/book';

interface Props {
  content: FooterContent;
}

const { content } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-border bg-surface px-gutter">
  <div class="mx-auto max-w-page py-stack">
    <div class="flex flex-col items-center gap-8 text-center md:flex-row md:items-start md:justify-between md:text-left">
      <div class="max-w-sm">
        {
          content.logo ? (
            <Image src={content.logo} alt={content.brand} height={64} class="mx-auto h-8 w-auto md:mx-0" />
          ) : (
            <p class="text-lg font-extrabold tracking-[-0.03em]">{content.brand}</p>
          )
        }
        <p class="mt-2 text-sm leading-relaxed text-secondary">{content.description}</p>
      </div>

      <nav aria-label="Footer">
        <ul class="flex max-w-md flex-wrap justify-center gap-x-6 gap-y-2.5 text-sm md:justify-end">
          {
            content.links.map((link) => (
              <li>
                <a href={link.href} class="text-secondary transition-colors hover:text-main">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-border pt-6 text-center text-xs text-secondary md:text-left">
      {`© ${year} ${content.copyrightHolder}. All rights reserved.`}
    </p>
  </div>
</footer>
